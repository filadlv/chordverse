{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "chordverse/chordverse",
  "type": "project",
  "description": "ChordVerse - Web pencarian chord lagu berbasis Laravel.",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "laravel/tinker": "^2.8"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.25",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}